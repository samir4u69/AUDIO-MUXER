# --- Telegram (required) ------------------------------------------------------
# Get these from https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here
# From @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# --- Access control -----------------------------------------------------------
# Your Telegram user ID (get it from @userinfobot)
OWNER_ID=123456789
# Space- or comma-separated extra admin user IDs (optional)
ADMIN_IDS=

# --- MongoDB ------------------------------------------------------------------
MONGO_URI=mongodb://mongo:27017
MONGO_DB=audiomuxer

# --- Limits -------------------------------------------------------------------
MAX_FILE_SIZE_MB=2000
MAX_DURATION_SECONDS=14400
MAX_CONCURRENT_JOBS=4
TEMP_TTL_SECONDS=86400

# --- Misc ---------------------------------------------------------------------
WORK_DIR=/data/audiomuxer
LOG_LEVEL=INFO
# Log file used by the /logs admin command (default: <WORK_DIR>/audiomuxer.log)
LOG_FILE=/data/audiomuxer/audiomuxer.log
# Min seconds between progress-bar message edits (Telegram rate limit safe)
PROGRESS_UPDATE_INTERVAL=1.5
